        "## 2. Base de conocimiento vectorial (ChromaDB + Gemini Embeddings)\n",
        "Pipeline: **carga → limpieza → chunking → embeddings → Chroma**.\n",
        "- *Limpieza:* une palabras cortadas, normaliza espacios y descarta páginas casi vacías (ruido).\n",
        "- *Chunking:* `RecursiveCharacterTextSplitter` de 1000 caracteres con 150 de solapamiento, para conservar ideas completas sin pasarse de tamaño.\n",
        "- *Idempotente:* si la colección ya existe en disco, se reutiliza (no se vuelven a pagar embeddings)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "9f315c7f",
      "metadata": {
        "id": "9f315c7f"
      },
      "outputs": [],
      "source": [
        "def clean_text(text: str) -> str:\n",
        "    \"\"\"Limpieza ligera: une palabras cortadas por guion, normaliza espacios y saltos.\"\"\"\n",
        "    text = re.sub(r\"(\\w)-\\n(\\w)\", r\"\\1\\2\", text)\n",
        "    text = re.sub(r\"[ \\t]+\", \" \", text)\n",
        "    text = re.sub(r\"\\n{3,}\", \"\\n\\n\", text)\n",
        "    return text.strip()\n",
        "\n",
        "\n",
        "def load_documents(docs_dir: str = DOCS_DIR) -> List[Document]:\n",
        "    \"\"\"Carga PDFs, CSVs, TXT y MD de la carpeta de documentos.\"\"\"\n",
        "    docs: List[Document] = []\n",
        "    for path in sorted(Path(docs_dir).rglob(\"*\")):\n",
        "        suffix = path.suffix.lower()\n",
        "        if suffix == \".pdf\":\n",
        "            loader = PyPDFLoader(str(path))\n",
        "        elif suffix == \".csv\":\n",
        "            loader = CSVLoader(str(path), encoding=\"utf-8\")\n",
        "        elif suffix in {\".txt\", \".md\"}:\n",
        "            loader = TextLoader(str(path), encoding=\"utf-8\")\n",
        "        else:\n",
        "            continue\n",
        "        loaded = loader.load()\n",
        "        for d in loaded:\n",
        "            d.metadata[\"source_name\"] = path.name\n",
        "            d.page_content = clean_text(d.page_content)\n",
        "        loaded = [d for d in loaded if len(d.page_content) > 50]  # elimina ruido/páginas vacías\n",
        "        docs.extend(loaded)\n",
        "        print(f\"  · {path.name}: {len(loaded)} páginas/filas útiles\")\n",
        "    if not docs:\n",
        "        raise FileNotFoundError(\n",
        "            f\"No hay documentos en '{docs_dir}/'. Añade al menos 3 PDFs/CSVs/TXT (~20 páginas).\"\n",
        "        )\n",
        "    return docs\n",
        "\n",
        "\n",
        "def _new_chroma() -> Chroma:\n",
        "    return Chroma(\n",
        "        collection_name=COLLECTION_NAME,\n",
        "        embedding_function=GoogleGenerativeAIEmbeddings(model=EMBEDDING_MODEL),\n",
        "        persist_directory=CHROMA_DIR,\n",
        "        collection_metadata={\"hnsw:space\": \"cosine\"},  # similitud coseno (scores 0-1)\n",
        "    )\n",
        "\n",
        "\n",
        "def build_vectorstore(rebuild: bool = False) -> Chroma:\n",
        "    \"\"\"Devuelve la colección de Chroma; la indexa solo si está vacía (o si rebuild=True).\"\"\"\n",
        "    vs = _new_chroma()\n",
        "    if rebuild and vs._collection.count() > 0:\n",
        "        vs.delete_collection()\n",
        "        vs = _new_chroma()\n",
        "\n",
        "    if vs._collection.count() > 0:\n",
        "        print(f\"Colección ya indexada: {vs._collection.count()} fragmentos (se reutiliza).\")\n",
        "        return vs\n",
        "\n",
        "    print(\"Cargando documentos...\")\n",
        "    docs = load_documents()\n",
        "    splitter = RecursiveCharacterTextSplitter(\n",
        "        chunk_size=CHUNK_SIZE,\n",
        "        chunk_overlap=CHUNK_OVERLAP,\n",
        "        separators=[\"\\n\\n\", \"\\n\", \". \", \" \", \"\"],\n",
        "    )\n",
        "    chunks = splitter.split_documents(docs)\n",
        "    for i, c in enumerate(chunks):\n",
        "        c.metadata[\"chunk_id\"] = i\n",
        "    print(f\"{len(docs)} páginas/filas -> {len(chunks)} fragmentos. Generando embeddings...\")\n",
        "\n",
        "    for i in range(0, len(chunks), BATCH_SIZE):\n",
        "        batch = chunks[i : i + BATCH_SIZE]\n",
        "        for attempt in range(4):  # reintentos por si salta el límite de cuota\n",
        "            try:\n",
        "                vs.add_documents(batch)\n",
        "                break\n",
        "            except Exception as e:\n",
        "                wait = 15 * (attempt + 1)\n",
        "                print(f\"  Error ({type(e).__name__}); reintento en {wait}s...\")\n",
        "                time.sleep(wait)\n",
        "        else:\n",
        "            raise RuntimeError(\"No se pudieron generar embeddings tras varios reintentos.\")\n",
        "        time.sleep(1)\n",
        "        print(f\"  {min(i + BATCH_SIZE, len(chunks))}/{len(chunks)}\")\n",
        "    print(f\"Indexados {vs._collection.count()} fragmentos en '{CHROMA_DIR}/'.\")\n",
        "    return vs"
      ]
    },
